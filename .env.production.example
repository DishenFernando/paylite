# Copy this to .env on the SERVER; never commit .env to GitHub.
# HTTPS: set your real public DNS hostname, e.g. wallet.example.com.
# For a temporary HTTP-only IP preview (not safe for real credentials), use APP_DOMAIN=:80.
APP_DOMAIN=wallet.example.com
POSTGRES_DB=paylite
POSTGRES_USER=paylite
# Generate a long random password on the server; do not leave this placeholder.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
SEED_DEMO=false
DAILY_TRANSFER_LIMIT=10000
